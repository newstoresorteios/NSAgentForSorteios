{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/catalog-url-health",
      "schedule": "15 5 * * *"
    },
    {
      "path": "/api/cron/tray-keepalive",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron/remarketing",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/product-image-index",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/attendance-learning",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/instagram-story-media-retention",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/process-inbox",
      "schedule": "10 3 * * *"
    },
    {
      "path": "/api/cron/process-outbox",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/order-tracking-audit",
      "schedule": "0 6 * * *"
    }
  ]
}
