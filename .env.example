ENVIRONMENT=production
APP_NAME=NewStoreAgent
DRY_RUN=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# chat_completions | responses | shadow | canary
# Phase 8: prefer canary→responses; chat_completions = emergency rollback only
OPENAI_API_MODE=chat_completions
OPENAI_CHAT_COMPLETIONS_PRIMARY_ALLOWED=true
OPENAI_STORE_RESPONSES=false
OPENAI_USE_PREVIOUS_RESPONSE_ID=false
OPENAI_USE_CONVERSATIONS_API=false
OPENAI_RESPONSES_STRUCTURED_ENABLED=true
OPENAI_RESPONSES_TOOL_LOOP_ENABLED=true
OPENAI_SHADOW_SAMPLE_RATE=0.10
# Phase 7 canary: fraction of sticky traffic on Responses as primary
OPENAI_RESPONSES_TRAFFIC_PERCENT=0.0
OPENAI_RESPONSES_FALLBACK_TO_CHAT=true
OPENAI_CANARY_STICKY_ROUTING=true
# Persona/memory rollout (later phases; keep false)
AGENT_DB_PERSONA_ENABLED=false
AGENT_PERSONA_TENANT_ID=newstore
AGENT_PERSONA_KEY=newstore_commercial
AGENT_MAX_RECENT_TURNS=8
AGENT_MAX_ACTIVE_CONTACT_MEMORIES=20
AGENT_MAX_CONTACT_MEMORY_CHARS=3000
AGENT_MAX_INSTRUCTION_EXTENSIONS=20
AGENT_MAX_INSTRUCTION_EXTENSION_CHARS=4000
AGENT_MAX_CONVERSATION_SUMMARY_CHARS=2500
# Phase 5/6: proposals audit; auto-apply only with allowlist
AGENT_MEMORY_PROPOSALS_ENABLED=false
AGENT_MEMORY_AUTO_APPLY_ENABLED=false
# Comma-separated sender_key list. Empty=nobody. *=all
AGENT_MEMORY_AUTO_APPLY_SENDER_ALLOWLIST=
AGENT_MEMORY_AUTO_APPLY_MIN_CONFIDENCE=0.85
AGENT_MEMORY_AUTO_APPLY_MIN_IMPORTANCE=0.70
AGENT_CONTACT_MEMORY_IN_PROMPT_ENABLED=false
AGENT_INSTRUCTION_EXTENSION_PROPOSALS_ENABLED=false
AGENT_CONVERSATION_SUMMARY_ENABLED=false
AGENT_PROMPT_COMPILATION_AUDIT_ENABLED=true
AGENT_DEBUG_STORE_COMPILED_PROMPT=false
# Rollback only: re-embeds fallback contract (duplicates prompt). Keep false.
AGENT_LEGACY_PROMPT_COMPAT_ENABLED=false
AGENT_RUNTIME_ENABLED=true
# Modo de observacao por padrao; habilite apenas apos validar as metricas.
AGENT_LLM_BUDGET_ENABLED=false
# Raise when AGENT_CRITIQUE_MODE is enabled (judge + regenerate uses extra calls).
AGENT_MAX_LLM_CALLS_PER_TURN=8
# off | shadow | enforce
AGENT_POLICY_MODE=shadow
AGENT_FACTUAL_VALIDATION_MODE=shadow
AGENT_TRUSTED_FACT_DOMAINS=sorteionewstore.com.br,newstoresorteios.com.br
AGENT_CONVERSATION_LOCK_ENABLED=true
AGENT_CONVERSATION_LOCK_TIMEOUT_SECONDS=15
# off | shadow | enforce
AGENT_QUALITY_JUDGE_MODE=shadow
AGENT_QUALITY_JUDGE_RISK_THRESHOLD=70
# Dual-agent critique with API catalog + retry before send (off|shadow|enforce)
AGENT_CRITIQUE_MODE=shadow
AGENT_CRITIQUE_MAX_RETRIES=2
# Model window sent to OpenAI. Operational recovery still uses HARD_CAP from DB.
AGENT_HISTORY_LIMIT=12
AGENT_HISTORY_HARD_CAP=80
AGENT_SEND_IDEMPOTENCY_ENABLED=true
# Busca por foto: Vision extrai marca/modelo/ref e pesquisa no catálogo
AGENT_IMAGE_SEARCH_ENABLED=true
# Opcional; vazio usa OPENAI_MODEL (precisa ser modelo com vision)
AGENT_IMAGE_SEARCH_MODEL=
AGENT_IMAGE_SEARCH_MIN_CONFIDENCE=0.55
AGENT_IMAGE_DOWNLOAD_MAX_BYTES=8000000
# Fallback visual (caption+embedding / pgvector) quando Vision ou busca textual falha
AGENT_VISUAL_SEARCH_ENABLED=true
AGENT_PRODUCT_IMAGE_INDEX_ENABLED=true
AGENT_VISUAL_EMBEDDING_MODEL=text-embedding-3-small
AGENT_VISUAL_TOP_K=3
AGENT_VISUAL_MAX_DISTANCE=0.45
AGENT_PRODUCT_IMAGE_INDEX_BATCH_SIZE=40
CHECKOUT_CEP_LOOKUP_ENABLED=true
CHECKOUT_CEP_LOOKUP_URL=https://viacep.com.br/ws

# Mercado Pago PIX direto (default off até ligar no fluxo de venda)
PIX_DIRECT_ENABLED=false
MP_ACCESS_TOKEN=
# Alternativa ao MP_ACCESS_TOKEN (mesmo valor); um dos dois basta
MERCADOPAGO_ACCESS_TOKEN=
MP_BASE_URL=https://api.mercadopago.com
PIX_EXP_MIN=30
# URL pública do agent (Vercel), sem barra final — usada no notification_url do MP
PUBLIC_URL=https://ns-agent-for-sorteios.vercel.app

BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
BREVO_REPLY_MODE=auto
BREVO_AGENT_ID=
BREVO_AGENT_EMAIL=
BREVO_AGENT_NAME=NewStoreAgent
BREVO_RECEIVED_FROM=NewStoreAgent
BREVO_SENDER_NUMBER=
BREVO_ALLOWED_CHANNELS=whatsapp,instagram,facebook
BREVO_SOCIAL_CHANNELS_ENABLED=true

DATABASE_URL=
AUTO_CREATE_TABLES=false
REMARKETING_ENABLED=false
REMARKETING_TOUCH_HOURS=1,12,23
REMARKETING_META_WINDOW_HOURS=24
REMARKETING_BATCH_SIZE=25
CRON_SECRET=

TRAY_ADAPTER_URL=
TRAY_ADAPTER_TOKEN=

ADMIN_API_TOKEN=
